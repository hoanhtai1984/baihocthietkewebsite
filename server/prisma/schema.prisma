generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon dùng PgBouncer (pooler) cho DATABASE_URL chạy app - Prisma Migrate
  // cần 1 kết nối TRỰC TIẾP (không qua pooler) mới hoạt động ổn định.
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  COMPLETED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  orders    Order[]
}

model Category {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  name     String
  icon     String?
  position Int       @default(0)
  products Product[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  brand       String
  price       Int
  oldPrice    Int?
  image       String
  description String
  specs       Json?
  stock       Int         @default(0)
  hidden      Boolean     @default(false)
  category    Category    @relation(fields: [categoryId], references: [id])
  categoryId  Int
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]

  @@index([categoryId])
}

model Order {
  id           Int         @id @default(autoincrement())
  code         String      @unique
  user         User?       @relation(fields: [userId], references: [id])
  userId       Int?
  guestName    String?
  guestPhone   String?
  guestAddress String?
  status       OrderStatus @default(PENDING)
  totalAmount  Int
  createdAt    DateTime    @default(now())
  items        OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  name      String
  price     Int
  quantity  Int
}
