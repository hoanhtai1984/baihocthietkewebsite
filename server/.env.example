# Copy file này thành .env rồi điền giá trị thật (KHÔNG commit .env lên git)

# Chuỗi kết nối PostgreSQL (Neon/Render/Supabase) - copy từ dashboard nhà cung cấp
# Neon: DATABASE_URL lấy bản có "-pooler" trong host (dùng cho app chạy thật),
# DIRECT_URL lấy bản KHÔNG có "-pooler" (chỉ Prisma Migrate dùng lúc tạo bảng)
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Chuỗi bí mật ký JWT - đặt 1 chuỗi ngẫu nhiên dài, khác nhau cho access/refresh
JWT_ACCESS_SECRET="doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai"
JWT_REFRESH_SECRET="doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-khac"

# API key Gemini (lấy tại https://aistudio.google.com/apikey) - KHÔNG bắt buộc:
# để trống thì ô gợi ý sản phẩm tự dùng gợi ý theo từ khoá + ngân sách
GEMINI_API_KEY=""
# Đổi model nếu Google ngừng model mặc định (không bắt buộc)
# GEMINI_MODEL="gemini-2.0-flash"

# URL frontend - dùng để whitelist CORS (nhiều địa chỉ: ngăn cách bằng dấu phẩy)
FE_URL="http://localhost:5173"

PORT=4000
NODE_ENV=development
